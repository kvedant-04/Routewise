# ================================
# Routewise Frontend Environment
# ================================

# Backend API URL
VITE_BACKEND_URL=http://localhost:8000

# ================================
# Image Providers
# ================================

# Unsplash API Key
# Get from: https://unsplash.com/developers
VITE_UNSPLASH_KEY=your_unsplash_api_key_here

# Pexels API Key
# Get from: https://pexels.com/api
VITE_PEXELS_KEY=your_pexels_api_key_here

# ================================
# Optional Future Providers
# ================================

# Pixabay
VITE_PIXABAY_KEY=

# Mapbox
VITE_MAPBOX_KEY=

# Google Maps
VITE_GOOGLE_MAPS_KEY=

# Gemini / AI Services
VITE_GEMINI_API_KEY=

# ================================
# App Environment
# ================================

VITE_APP_NAME=Routewise
VITE_APP_ENV=development